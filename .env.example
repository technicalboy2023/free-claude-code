# =====================================================================
# Free Claude Code — Environment Configuration
# =====================================================================
# Copy this file to .env and fill in the values you need.
#   cp .env.example .env        (macOS/Linux)
#   Copy-Item .env.example .env (PowerShell)
# =====================================================================


# ── Provider API Keys ────────────────────────────────────────────────
# Supports comma-separated keys for round-robin rotation:
#   NVIDIA_NIM_API_KEY="nvapi-key1,nvapi-key2,nvapi-key3"
# Fill at least one provider key.

# NVIDIA NIM  — https://build.nvidia.com/settings/api-keys
NVIDIA_NIM_API_KEY=""

# OpenRouter  — https://openrouter.ai/keys
OPENROUTER_API_KEY=""

# DeepSeek    — https://platform.deepseek.com/api_keys
# (uses native Anthropic Messages at api.deepseek.com/anthropic)
DEEPSEEK_API_KEY=""

# Ollama Cloud — https://ollama.com
# (uses OpenAI-compatible API at ollama.com/v1)
# Example multi-key: OLLAMA_API_KEY="key1,key2"
OLLAMA_API_KEY="ollama"


# ── Model Routing ────────────────────────────────────────────────────
# Format: provider_id/model_name
# Valid providers: "nvidia_nim" | "open_router" | "deepseek" | "ollama"
# MODEL is the fallback; per-tier overrides are optional.
MODEL="nvidia_nim/z-ai/glm4.7"
MODEL_OPUS=
MODEL_SONNET=
MODEL_HAIKU=


# ── Thinking / Reasoning ─────────────────────────────────────────────
# Per-Claude-model switches for provider reasoning and Claude thinking blocks.
# Blank per-model switches inherit ENABLE_MODEL_THINKING.
ENABLE_MODEL_THINKING=true
ENABLE_OPUS_THINKING=
ENABLE_SONNET_THINKING=
ENABLE_HAIKU_THINKING=


# ── Smoke Test Model Overrides (optional) ────────────────────────────
# Provider smoke runs once per configured provider, even when
# MODEL/MODEL_* route to a different provider.
FCC_SMOKE_MODEL_NVIDIA_NIM=
FCC_SMOKE_MODEL_OPEN_ROUTER=
FCC_SMOKE_MODEL_DEEPSEEK=
FCC_SMOKE_MODEL_OLLAMA=


# ── Server Auth ──────────────────────────────────────────────────────
# Clients must send this as x-api-key or Authorization bearer.
# Use any value you like; leave empty only for private/local testing.
ANTHROPIC_AUTH_TOKEN="freecc"


# ── Provider Network Config ──────────────────────────────────────────
# Per-provider proxy support: http and socks5
# Example: "http://username:password@host:port"
NVIDIA_NIM_PROXY=""
OPENROUTER_PROXY=""
OLLAMA_PROXY=""


# ── Rate Limits & Timeouts ───────────────────────────────────────────
PROVIDER_RATE_LIMIT=1
PROVIDER_RATE_WINDOW=3
PROVIDER_MAX_CONCURRENCY=5

# HTTP client timeouts (seconds) for provider API requests
HTTP_READ_TIMEOUT=300
HTTP_WRITE_TIMEOUT=10
HTTP_CONNECT_TIMEOUT=10


# ── Messaging Platform ──────────────────────────────────────────────
# "telegram" | "discord" | "none"
MESSAGING_PLATFORM="none"
MESSAGING_RATE_LIMIT=1
MESSAGING_RATE_WINDOW=1

# Telegram Config
TELEGRAM_BOT_TOKEN=""
ALLOWED_TELEGRAM_USER_ID=""

# Discord Config
DISCORD_BOT_TOKEN=""
ALLOWED_DISCORD_CHANNELS=""


# ── Voice Note Transcription ─────────────────────────────────────────
VOICE_NOTE_ENABLED=false
# WHISPER_DEVICE: "cpu" | "cuda" | "nvidia_nim"
#   cpu/cuda  → Hugging Face transformers Whisper (offline, free)
#               Install: uv sync --extra voice_local
#   nvidia_nim → NVIDIA NIM Whisper via Riva gRPC
#               Install: uv sync --extra voice
WHISPER_DEVICE="nvidia_nim"
WHISPER_MODEL="openai/whisper-large-v3"
HF_TOKEN=""


# ── Agent / CLI Config ───────────────────────────────────────────────
CLAUDE_WORKSPACE="./agent_workspace"
ALLOWED_DIR=""
CLAUDE_CLI_BIN="claude"
FAST_PREFIX_DETECTION=true
ENABLE_NETWORK_PROBE_MOCK=true
ENABLE_TITLE_GENERATION_SKIP=true
ENABLE_SUGGESTION_MODE_SKIP=true
ENABLE_FILEPATH_EXTRACTION_MOCK=true


# ── Local Web Tools ──────────────────────────────────────────────────
# Performs outbound HTTP from the proxy (web_search / web_fetch).
ENABLE_WEB_SERVER_TOOLS=true
WEB_FETCH_ALLOWED_SCHEMES=http,https
WEB_FETCH_ALLOW_PRIVATE_NETWORKS=false


# ── Diagnostics (keep OFF in production) ─────────────────────────────
LOG_LEVEL="info"
DEBUG_PLATFORM_EDITS=false
DEBUG_SUBAGENT_STACK=false
LOG_RAW_API_PAYLOADS=false
LOG_RAW_SSE_EVENTS=false
LOG_API_ERROR_TRACEBACKS=false
LOG_RAW_MESSAGING_CONTENT=false
LOG_RAW_CLI_DIAGNOSTICS=false
LOG_MESSAGING_ERROR_DETAILS=false
